#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUN_DIR="$ROOT_DIR/.run"
PID_DIR="$RUN_DIR/pids"
LOG_DIR="$RUN_DIR/logs"

API_PORT="${API_PORT:-4000}"
WEB_PORT="${WEB_PORT:-3000}"

API_PID_FILE="$PID_DIR/api.pid"
WEB_PID_FILE="$PID_DIR/web.pid"
CADDY_PID_FILE="$PID_DIR/caddy.pid"

mkdir -p "$PID_DIR" "$LOG_DIR"

print_usage() {
  echo "Usage: ./manage <start|stop|status>"
}

is_running() {
  local pid_file="$1"
  if [[ ! -f "$pid_file" ]]; then
    return 1
  fi
  local pid
  pid="$(cat "$pid_file")"
  if [[ -z "$pid" ]]; then
    return 1
  fi
  if kill -0 "$pid" 2>/dev/null; then
    return 0
  fi
  return 1
}

ensure_caddy() {
  if command -v caddy >/dev/null 2>&1; then
    return
  fi

  echo "Caddy is not installed. Installing..."
  if [[ "$(uname -s)" == "Darwin" ]] && command -v brew >/dev/null 2>&1; then
    brew install caddy
  else
    echo "Automatic Caddy install is only configured for macOS with Homebrew."
    echo "Install caddy manually: https://caddyserver.com/docs/install"
    exit 1
  fi
}

write_caddyfile() {
  cat > "$RUN_DIR/Caddyfile" <<EOF
:80 {
  reverse_proxy localhost:${WEB_PORT}
}

:443 {
  tls internal
  reverse_proxy localhost:${WEB_PORT}
}
EOF
}

install_dependencies() {
  if [[ ! -d "$ROOT_DIR/apps/api/node_modules" ]]; then
    echo "Installing API dependencies..."
    (cd "$ROOT_DIR/apps/api" && npm install --include=dev)
  fi
  if [[ ! -d "$ROOT_DIR/apps/web/node_modules" ]]; then
    echo "Installing frontend dependencies..."
    (cd "$ROOT_DIR/apps/web" && npm install)
  fi
}

run_migrations() {
  if [[ -z "${DATABASE_URL:-}" ]]; then
    echo "DATABASE_URL is required."
    echo "Example:"
    echo "  export DATABASE_URL='postgresql://ledger:ledger_dev_password@localhost:5432/ledger'"
    exit 1
  fi
  echo "Running migrations..."
  (cd "$ROOT_DIR/apps/api" && npm run migrate)
}

start_api() {
  if is_running "$API_PID_FILE"; then
    echo "API already running"
    return
  fi
  echo "Starting API on port $API_PORT..."
  (
    cd "$ROOT_DIR/apps/api"
    PORT="$API_PORT" npm run dev >> "$LOG_DIR/api.log" 2>&1
  ) &
  echo $! > "$API_PID_FILE"
}

start_web() {
  if is_running "$WEB_PID_FILE"; then
    echo "Frontend already running"
    return
  fi
  echo "Starting frontend on port $WEB_PORT..."
  (
    cd "$ROOT_DIR/apps/web"
    NEXT_PUBLIC_API_URL="http://localhost:$API_PORT" npm run dev -- -p "$WEB_PORT" >> "$LOG_DIR/web.log" 2>&1
  ) &
  echo $! > "$WEB_PID_FILE"
}

start_caddy() {
  if is_running "$CADDY_PID_FILE"; then
    echo "Caddy already running"
    return
  fi
  ensure_caddy
  write_caddyfile

  echo "Starting Caddy reverse proxy on ports 80 and 443..."
  (
    caddy run --config "$RUN_DIR/Caddyfile" --adapter caddyfile >> "$LOG_DIR/caddy.log" 2>&1
  ) &
  echo $! > "$CADDY_PID_FILE"
}

stop_process() {
  local name="$1"
  local pid_file="$2"
  if is_running "$pid_file"; then
    local pid
    pid="$(cat "$pid_file")"
    echo "Stopping $name (pid $pid)..."
    kill "$pid" 2>/dev/null || true
  else
    echo "$name not running"
  fi
  rm -f "$pid_file"
}

status_process() {
  local name="$1"
  local pid_file="$2"
  if is_running "$pid_file"; then
    echo "$name: running (pid $(cat "$pid_file"))"
  else
    echo "$name: stopped"
  fi
}

command="${1:-}"

case "$command" in
  start)
    install_dependencies
    run_migrations
    start_api
    start_web
    start_caddy
    echo
    echo "All services requested."
    echo "App via proxy:"
    echo "  http://<your-ip>/"
    echo "  https://<your-ip>/"
    echo
    echo "Logs:"
    echo "  $LOG_DIR/api.log"
    echo "  $LOG_DIR/web.log"
    echo "  $LOG_DIR/caddy.log"
    ;;
  stop)
    stop_process "Caddy" "$CADDY_PID_FILE"
    stop_process "Frontend" "$WEB_PID_FILE"
    stop_process "API" "$API_PID_FILE"
    ;;
  status)
    status_process "API" "$API_PID_FILE"
    status_process "Frontend" "$WEB_PID_FILE"
    status_process "Caddy" "$CADDY_PID_FILE"
    ;;
  *)
    print_usage
    exit 1
    ;;
esac
